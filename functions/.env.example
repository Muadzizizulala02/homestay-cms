FIREBASE_PROJECT_ID=homestay-cms
SENDGRID_API_KEY=xxx

CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Billplz: use the sandbox secret key/collection while testing (billplz-sandbox.com),
# switch BILLPLZ_BASE_URL to https://www.billplz.com to go live.
BILLPLZ_SECRET_KEY=xxx
BILLPLZ_COLLECTION_ID=xxx
BILLPLZ_X_SIGNATURE_KEY=xxx
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com

# Public origins Billplz needs to reach: FRONTEND_BASE_URL is where the guest is redirected
# after paying; API_BASE_URL is where Billplz sends the server-to-server webhook. Neither can
# be localhost — Billplz can't reach your machine directly, so local testing needs a tunnel
# (e.g. ngrok) pointed at the Functions emulator.
FRONTEND_BASE_URL=https://your-frontend-domain.example
API_BASE_URL=https://us-central1-homestay-cms.cloudfunctions.net
