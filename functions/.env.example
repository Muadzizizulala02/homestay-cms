# Do NOT add a key starting with FIREBASE_ (or a few other reserved prefixes) here — Cloud
# Functions refuses to load the *entire* function if it finds one, not just that one value.
# (FIREBASE_PROJECT_ID used to be here; it broke every route once a real .env existed. Nothing
# in this codebase needs it — initializeApp() auto-detects the project.)
SENDGRID_API_KEY=xxx

CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ToyyibPay: use your sandbox secret key/category (dev.toyyibpay.com — a separate account
# from production), switch TOYYIBPAY_BASE_URL to https://toyyibpay.com to go live. The same
# secret key is also used to compute/verify the callback hash — there's no separate signing key.
TOYYIBPAY_SECRET_KEY=xxx
TOYYIBPAY_CATEGORY_CODE=xxx
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# Public origins ToyyibPay needs to reach: FRONTEND_BASE_URL is where the guest is redirected
# after paying; API_BASE_URL is where ToyyibPay sends the server-to-server callback. Neither
# can be localhost — ToyyibPay can't reach your machine directly, so local testing needs a
# tunnel (e.g. ngrok) pointed at the Functions emulator.
FRONTEND_BASE_URL=https://your-frontend-domain.example
API_BASE_URL=https://us-central1-homestay-cms.cloudfunctions.net
